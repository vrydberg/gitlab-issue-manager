<header class="header">
    <button class="hamburger-btn" id="hamburger-btn" aria-label="Toggle navigation menu">
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
    </button>
    <div class="header-left">
        <a href="/issues" class="header-brand">
            <img src="/images/logo.svg" alt="" class="header-brand-logo" width="26" height="26">
            <div class="header-brand-text">
                <span class="header-brand-name">IssueManager</span>
                <span class="header-brand-subtitle">for GitLab</span>
            </div>
        </a>

        <div class="header-divider"></div>

        <%
    const repoPath = typeof projectPath !== 'undefined' && projectPath ? projectPath : 'vrydberg/testing-repo';
    const repoParts = repoPath.split('/');
%>
<span class="header-repo">
    <span class="repo-namespace"><%= repoParts[0] %></span>
    <span class="repo-separator">/</span>
    <span class="repo-name"><%= repoParts.slice(1).join('/') %></span>
</span>
    </div>

    <div class="header-right">
        <form action="/logout" method="post">
            <button type="submit" class="base-btn header-logout-btn">Log out</button>
        </form>
    </div>
</header>
